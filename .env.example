# PayPal sandbox REST app credentials (developer.paypal.com)
# Without these, payments run in clearly-labeled SIMULATED mode.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Google Gemini API key (Google AI Studio) — enables the live vision
# model at the photo door: uploaded invoice photos are read by Gemini
# (app/vision_model.py) and the read feeds the extraction pipeline.
# Without it, the photo door falls back to matching the demo's sample
# invoice photos, so the app runs fully with no model key set.
GEMINI_API_KEY=
# Optional: which Gemini model reads photos. Defaults to gemini-3.8-flash.
GEMINI_MODEL=
# Optional: data directory for ledger/payment state. Defaults to the
# repo's data/ folder; on a hosted deploy, point it at a persistent
# disk mount (Render: /var/data — see render.yaml).
DATA_DIR=
